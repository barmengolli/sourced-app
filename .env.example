# Sourced — environment variables template
# Copy this file to .env in the sourced-app repo root and fill in real values.
# .env is gitignored and never committed.

# Supabase project credentials (get from Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Client-side password gate (same as DataVis 1 for now)
VITE_APP_PASSWORD=HWWQa4yD5vkX

# Section-level password gate for the Leads view. Locked by default
# on every mount and after 10 minutes of inactivity. Keep this
# DIFFERENT from VITE_APP_PASSWORD. Share only with users who need
# raw lead PII for ops (typically Ben + Dan).
VITE_REVEAL_PII_PASSWORD=changeme
