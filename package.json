{
  "name": "sourced-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:salesforce-daily-workflow": "node scripts/build-salesforce-campaign-member-daily-workflow.mjs",
    "check:salesforce-daily-workflow": "node scripts/build-salesforce-campaign-member-daily-workflow.mjs --check",
    "build:opportunity-scope-workflow": "node scripts/build-salesforce-opportunity-scope-audit-workflow.mjs",
    "check:opportunity-scope-workflow": "node scripts/build-salesforce-opportunity-scope-audit-workflow.mjs --check",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false --noEmit",
    "build:app": "vite build",
    "build": "npm run typecheck && npm run build:app",
    "verify": "npm run check:salesforce-daily-workflow && npm run check:opportunity-scope-workflow && npm run test && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^2.1.9"
  }
}
